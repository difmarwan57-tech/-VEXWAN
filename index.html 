<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>VEXWAN</title><style>*{margin:0;padding:0;box-sizing:border-box;font-family:system-ui}body{background:#f0fdf4}header{background:linear-gradient(135deg,#16a34a,#065f46);color:#fff;padding:12px;text-align:center}header h1{font-size:16px}header p{font-size:10px;line-height:1.6;margin-top:4px}.tabs{display:flex;gap:4px;padding:6px;background:#fff;overflow-x:auto;position:sticky;top:0}.tab{padding:8px 10px;border-radius:20px;border:1px solid #bbf7d0;background:#f1f5f9;font-size:10px;font-weight:bold;white-space:nowrap;cursor:pointer}.tab.active{background:#16a34a;color:#fff}.sec{display:none;padding:10px}.sec.active{display:block}.card{background:#fff;border-radius:12px;padding:12px;margin-bottom:8px;border-right:5px solid #16a34a}.card h3{color:#16a34a;font-size:12px;margin-bottom:6px}#chat{height:42vh;overflow:auto;background:#fff;border-radius:12px;padding:8px}.user{background:#16a34a;color:#fff;padding:6px 10px;border-radius:16px 4px 16px 16px;margin:4px 0;margin-left:16px;font-size:11px}.bot{background:#f1f5f9;padding:7px 10px;border-radius:4px 16px 16px 16px;margin:4px 0;font-size:11px;line-height:1.8}.controls{display:flex;gap:4px;background:#fff;padding:5px;border-radius:20px;margin-top:5px}#inp{flex:1;padding:9px;border-radius:20px;border:2px solid #16a34a;font-size:11px}button.i{width:36px;height:36px;border-radius:50%;border:none;background:#16a34a;color:#fff;cursor:pointer}ul{padding-right:12px;font-size:11px;line-height:1.9}footer{text-align:center;padding:8px;font-size:9px;color:#666;background:#fff}</style></head><body>
<header><h1>🌍 VEXWAN - منصة الحلال الشاملة 100%</h1><p>وَأَنْ لَيْسَ لِلْإِنْسَانِ إِلَّا مَا سَعَىٰ<br>مشاريع حلال | شركات كبرى وصغرى حلال | زراعة حلال | تعليم وصحة | مال وزكاة وصوم وحج | كتب PDF حلال فقط<br>صوت رجل + شات + 100 لغة - فَاسْأَلُوا أَهْلَ الذِّكْرِ</p></header>
<div class="tabs"><button class="tab active" onclick="op('chat',this)">💬 شات صوت رجل</button><button class="tab" onclick="op('machari3',this)">✅ مشاريع</button><button class="tab" onclick="op('charikat',this)">🏢 شركات</button><button class="tab" onclick="op('zira3a',this)">🌱 زراعة</button><button class="tab" onclick="op('ta3lim',this)">📚 تعليم</button><button class="tab" onclick="op('mal',this)">💰 مال</button><button class="tab" onclick="op('ibadat',this)">🕋 عبادات</button><button class="tab" onclick="op('kutub',this)">📖 كتب</button></div>
<div id="chat" class="sec active"><div id="box"><div class="bot"><b>VEXWAN:</b> السلام عليكم! أدعم فقط الحلال 100%: مشاريع، شركات كبرى وصغرى، زراعة، تعليم، صحة، مال، زكاة، صوم، حج، كتب PDF حلال. صوت رجل بـ100 لغة + شات. فَاسْأَلُوا أَهْلَ الذِّكْرِ 🔊</div></div><div class="controls"><input id="inp" placeholder="سول بأي لغة..."><button class="i" onclick="send()">📤</button><button class="i" onclick="mic()">🎤</button></div></div>
<div id="machari3" class="sec"><div class="card"><h3>✅ مشاريع حلال</h3><ul><li>صغرى وكبرى: زيتون، ألبان حلال، طاقة شمسية - بلا ربا</li></ul></div></div>
<div id="charikat" class="sec"><div class="card"><h3>🏢 شركات حلال</h3><ul><li>كبرى وصغرى بشهادة حلال بلا ربا</li></ul></div></div>
<div id="zira3a" class="sec"><div class="card"><h3>🌱 زراعة حلال</h3><ul><li>عضوية حلال - PDF حلال</li></ul></div></div>
<div id="ta3lim" class="sec"><div class="card"><h3>📚 تعليم وصحة</h3><ul><li>بلا موسيقى - طب نبوي - PDF حلال</li></ul></div></div>
<div id="mal" class="sec"><div class="card"><h3>💰 مال وزكاة</h3><ul><li>بلا ربا - إِنَّمَا الصَّدَقَاتُ لِلْفُقَرَاءِ [التوبة 60]</li></ul></div></div>
<div id="ibadat" class="sec"><div class="card"><h3>🕋 صوم وحج</h3><ul><li>صوم وحج - PDF فقه الصيام والحج</li></ul></div></div>
<div id="kutub" class="sec"><div class="card"><h3>📖 كتب PDF حلال</h3><ul><li>قرآن، بخاري، رياض الصالحين، فقه السنة - حلال فقط</li></ul></div></div>
<footer>© VEXWAN - MEROUAN 2025 | فَاسْأَلُوا أَهْلَ الذِّكْرِ</footer>
<script>
function op(id,el){document.querySelectorAll('.sec').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));el.classList.add('active')}
const box=document.getElementById('box'),inp=document.getElementById('inp');
function add(t,c){let d=document.createElement('div');d.className=c;d.innerHTML=t;box.appendChild(d);box.scrollTop=999999}
let voices=[];function loadVoices(){voices=speechSynthesis.getVoices()}speechSynthesis.onvoiceschanged=loadVoices;loadVoices();
function detectLang(txt){if(/[ء-ي]/.test(txt))return 'ar-SA';let l=txt.toLowerCase();if(l.includes('bonjour')||l.includes('merci'))return 'fr-FR';if(l.includes('hello'))return 'en-US';if(l.includes('hola'))return 'es-ES';if(l.includes('hallo'))return 'de-DE';return 'ar-SA'}
function getMaleVoice(lang){let v=voices.find(x=>x.lang===lang&&x.name.toLowerCase().includes('male'))||voices.find(x=>x.lang===lang)||voices.find(x=>x.lang.startsWith(lang.split('-')[0]))||voices[0];return v}
function speakMale(txt){let clean=txt.replace(/<[^>]*>/g,'');let lang=detectLang(clean);let u=new SpeechSynthesisUtterance(clean);u.lang=lang;let mv=getMaleVoice(lang);if(mv)u.voice=mv;u.rate=0.9;u.pitch=0.65;speechSynthesis.speak(u)}
function getAns(q){q=q.toLowerCase();if(q.includes('ربا'))return "⚖️ الربا حرام - وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا [البقرة 275] - البديل حلال بلا ربا";if(q.includes('خمر')||q.includes('قمار'))return "⚖️ حرام - إِنَّمَا الْخَمْرُ وَالْمَيْسِرُ رِجْسٌ [المائدة 90] - فَاسْأَلُوا أَهْلَ الذِّكْرِ";if(q.includes('موسيقى'))return "⚖️ جمهور العلماء على تحريم المعازف - البديل قرآن";if(q.includes('زكاة'))return "✅ الزكاة حلال: إِنَّمَا الصَّدَقَاتُ لِلْفُقَرَاءِ [التوبة 60]";return null}
function send(){let t=inp.value.trim();if(!t)return;add(t,'user');inp.value='';setTimeout(()=>{let a=getAns(t);if(a){add(a,'bot');speakMale(a)}else{let b="✅ حلال: "+t+" - تجده في VEXWAN: مشاريع، شركات كبرى وصغرى، زراعة، تعليم، مال، صوم، حج، كتب PDF حلال فقط. وَأَنْ لَيْسَ لِلْإِنْسَانِ إِلَّا مَا سَعَىٰ";add(b,'bot');speakMale(b)}},250)}
function mic(){let R=window.SpeechRecognition||window.webkitSpeechRecognition;if(!R){alert("لا يدعم");return}let r=new R();r.lang='ar-SA';r.onresult=e=>{inp.value=e.results[0][0].transcript;send()};r.start()}
inp.addEventListener('keypress',e=>{if(e.key==='Enter')send()})
</script></body></html>